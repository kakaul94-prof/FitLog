{
  // Type-checks the contract tests, with the Pages Functions they call
  // in-process. Run by `npm run test:contracts`; not part of `npm run build`.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.contracts.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["contracts", "functions/api"],
  "exclude": []
}
