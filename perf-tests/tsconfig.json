{
  // Type-checking only: k6 itself transpiles the TypeScript (no bundler, no
  // emit). `npm run typecheck` here; CI runs it before the smoke scenario.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["k6"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["types", "config", "lib", "journeys", "scenarios", "scripts/*.ts"]
}
