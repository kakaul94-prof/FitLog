# Copy this file to ".env" and fill in your own values.
# (.env is git-ignored — never commit your real keys.)

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# USDA FoodData Central → https://fdc.nal.usda.gov/api-key-signup.html
VITE_USDA_API_KEY=YOUR-USDA-KEY

# Error tracking (Sentry) — leave blank locally. Set on the deployed sites only
# (Cloudflare Pages build variables); never active in `npm run dev` or tests.
# VITE_SENTRY_ENV tags events: production (fitlog-prod) or dev (fitlog).
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=
